{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.orhansavash/zentria-flow-mcp",
  "title": "Zentria Flow",
  "description": "US tariff layers by HTS code and origin, origin comparison, HTSUS search and landed cost.",
  "version": "0.3.2",
  "websiteUrl": "https://zentriaflow.com/developers",
  "icons": [
    {
      "src": "https://zentriaflow.com/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://zentriaflow.com/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/orhansavash/zentria-flow-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://zentriaflow.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/orhansavash/zentria-flow-mcp:0.3.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ZENTRIA_API_KEY",
          "description": "Zentria Flow API key (starts with zf_live_). Only the landed_cost tool needs it; the three tariff tools work without a key.",
          "format": "string",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "ZENTRIA_API_BASE",
          "description": "API base URL. Default: https://zentriaflow.com",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
